{
  "name": "rumrunner",
  "version": "0.1.0",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "rumrunner": "./src/bin.ts",
    "rumrunner-dev": "./src/rumrunner-dev.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "ui-dev": "chokidar 'src/ui/**' '!src/ui/dist/**' -c 'bunx vite build --config vite.config.ts'",
    "dev": "concurrently \"bun run ui-dev\" \"bun run server\"",
    "server": "bun run src/rumrunnerServer.ts",
    "ui:dev": "vite --config vite.config.ts --port 5173",
    "build:ui": "vite build --config vite.config.ts",
    "preview:ui": "vite preview --config vite.config.ts --port 4173",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "install:browsers": "playwright install"
  },
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/bun": "^1.2.15",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "chokidar": "^4.0.3",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.1.8"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "clipboardy": "^4.0.0",
    "esbuild": "^0.25.5",
    "hono": "^4.7.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "temp-dir": "^3.0.0",
    "vite": "^6.3.5"
  }
}
